    "angular-i18n",
    "next-i18next",
    "nodejs",
    "javascript",
    "typescript",
    "cli",
    "command-line",
    "developer-tools",
    "translation-management",
    "framework-detection",
    "zero-dependency",
    "security",
    "json"
  ],
  "homepage": "https://github.com/vladnoskv/i18ntk#readme",
  "bugs": {
    "url": "https://github.com/vladnoskv/i18ntk/issues"
  },
